# Netlify: o que não tem hash no nome precisa ser sempre conferido na rede, senão o celular
# fica preso na versão antiga (sw.js e index.html decidem qual versão do app carrega).
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
# arquivos do build com hash no nome (assets/index-XXXX.js) nunca mudam de conteúdo
/assets/*
  Cache-Control: public, max-age=31536000, immutable
